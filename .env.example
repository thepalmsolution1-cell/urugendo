# Backend Service Configuration
PORT=5000
NODE_ENV=development

# Machine Learning Service Configuration
ML_SERVICE_URL=http://localhost:8000

# Database Connection (PostgreSQL + pgvector)
DATABASE_URL=postgresql://urugendo_user:urugendo_password@localhost:5432/urugendo_db?schema=public

# NVIDIA NIM API Configuration (AI Layer: Intent Extraction & Vector Embeddings)
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
